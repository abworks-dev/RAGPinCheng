# GPU 推理服务配置

# 服务监听地址 — 默认只监听内网 IP，不监听 0.0.0.0
HOST=127.0.0.1
PORT=8100

# API Token — 用于 Ubuntu 调用时的身份验证
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
GPU_SERVICE_TOKEN=

# 模型配置
EMBED_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 模型缓存目录（默认 HuggingFace 缓存）
# HF_HOME=

# 推理限制
# 单次请求最大文本数
MAX_BATCH_SIZE=100
# 单条文本最大字符数
MAX_TEXT_LENGTH=8192
# 请求体最大字节数（含 JSON 开销）
MAX_REQUEST_BYTES=1048576  # 1 MB

# 日志级别
LOG_LEVEL=INFO
