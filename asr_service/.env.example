# Windows ASR service configuration only.
# Production location: ${PRODUCTION_DATA_ROOT}\RAGPinCheng-ASR\config\asr.env
# Do not merge this file with the Ubuntu backend prod.env.
ASR_SERVICE_ENABLED=false
ASR_SERVICE_TOKEN=
ASR_SERVICE_HOST=0.0.0.0
ASR_SERVICE_PORT=8200
ASR_SERVICE_SPOOL_ROOT=${PRODUCTION_DATA_ROOT}\RAGPinCheng-ASR\spool
ASR_MAX_INPUT_BYTES=2147483648
ASR_UPLOAD_PART_BYTES=8388608
ASR_MAX_QUEUE_LENGTH=8
ASR_CHUNK_DURATION_MS=300000
ASR_CONSECUTIVE_FAILURE_LIMIT=3

# The runtime accepts only the pinned offline SenseVoice revision below.
ASR_MODEL_CACHE_ROOT=${PRODUCTION_DATA_ROOT}\RAGPinCheng-ASR\models
ASR_MODEL_MANIFEST_PATH=${PRODUCTION_DATA_ROOT}\RAGPinCheng-ASR\models\SenseVoiceSmall\7bf452403abd7353a300cd760f7adae7701c92c1\model-manifest.json
ASR_MODEL_LOCAL_FILES_ONLY=true
ASR_LOG_DIR=${PRODUCTION_DATA_ROOT}\RAGPinCheng-ASR\logs

# Authenticated activity endpoint exposed by the existing GPU service on port 8100.
BGE_PRIORITY_PROBE_URL=http://${PRIVATE_IPV4}:8100/v1/activity
BGE_PRIORITY_PROBE_TOKEN=
BGE_PRIORITY_PROBE_CONNECT_TIMEOUT_SECONDS=3
BGE_PRIORITY_PROBE_REQUEST_TIMEOUT_SECONDS=5
