# Windows ASR service configuration only.
# Production location is supplied by the private deployment environment.
# Do not merge this file with the Ubuntu backend prod.env.
ASR_SERVICE_ENABLED=false
ASR_SERVICE_TOKEN=
ASR_SERVICE_HOST=0.0.0.0
ASR_SERVICE_PORT=8200
ASR_SERVICE_SPOOL_ROOT=./runtime/asr/spool
ASR_MAX_INPUT_BYTES=2147483648
ASR_UPLOAD_PART_BYTES=8388608
ASR_MAX_QUEUE_LENGTH=8
ASR_CHUNK_DURATION_MS=300000
ASR_CONSECUTIVE_FAILURE_LIMIT=3

# The enabled production runtime still requires the pinned offline SenseVoice model.
ASR_MODEL_CACHE_ROOT=./runtime/asr/models
ASR_MODEL_MANIFEST_PATH=./runtime/asr/models/SenseVoiceSmall/model-manifest.json
ASR_MODEL_LOCAL_FILES_ONLY=true

# Optional R2 faster-whisper cache. Keep both values empty until separately
# approved model preparation and GPU validation are complete.
ASR_FASTER_WHISPER_MODEL_CACHE_ROOT=
ASR_FASTER_WHISPER_MODEL_MANIFEST_PATH=
ASR_LOG_DIR=./runtime/asr/logs

# Authenticated activity endpoint exposed by the existing GPU service on port 8100.
BGE_PRIORITY_PROBE_URL=http://127.0.0.1:8100/v1/activity
BGE_PRIORITY_PROBE_TOKEN=
BGE_PRIORITY_PROBE_CONNECT_TIMEOUT_SECONDS=3
BGE_PRIORITY_PROBE_REQUEST_TIMEOUT_SECONDS=5
