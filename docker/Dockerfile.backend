# syntax=docker/dockerfile:1.7

# Combined image — FastAPI + ChatSession + Qdrant client + React SPA.
# No GPU dependencies (torch, BGE models) — those run on the separate
# Windows GPU inference service (gpu_service/).
#
# The backend configures EMBED_PROVIDER=remote and RERANK_PROVIDER=remote
# to delegate embedding and reranking to the GPU service over HTTP.
#
# Cross-platform build support: docker-compose.yml DISABLED build.platforms
# by default for best Docker layer caching on native x86_64 servers.
# For Apple Silicon Macs that need to build amd64 images for the server,
# uncomment the platforms section in docker-compose.yml to force emulation.

# ── Stage 1: build the React/Vite bundle ───────────────────────────────────
FROM node:20-alpine AS frontend-build

WORKDIR /build

# Cache npm install separately from the source — only re-runs when package
# files change, not on every code edit.
COPY frontend/package.json frontend/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm,sharing=locked \
    npm ci

COPY frontend/ ./
RUN npm run build
# Produces /build/dist/ — copied into the runtime stage below.


# ── Stage 2: Python runtime ────────────────────────────────────────────────
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_CACHE_DIR=/root/.cache/pip \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# Minimal system deps:
#   curl            — used by the healthcheck
#   build-essential — pip compiles any wheel that doesn't ship prebuilt for
#                     the target arch (mainly an arm64 concern; most amd64
#                     wheels are prebuilt on PyPI)
# Uses Tsinghua mirror for faster apt downloads in China.
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt/lists,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean \
    && rm -rf /etc/apt/sources.list.d/*.sources /etc/apt/sources.list \
    && echo "deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie main contrib non-free non-free-firmware" > /etc/apt/sources.list \
    && echo "deb https://mirrors.tuna.tsinghua.edu.cn/debian/ trixie-updates main contrib non-free non-free-firmware" >> /etc/apt/sources.list \
    && echo "deb https://mirrors.tuna.tsinghua.edu.cn/debian-security trixie-security main contrib non-free non-free-firmware" >> /etc/apt/sources.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        build-essential

WORKDIR /app

# Production Python deps — no GPU dependencies (torch, FlagEmbedding, etc.)
# since those run on the separate Windows GPU inference service.
# Uses Tsinghua mirror for faster pip downloads in China.
COPY requirements-prod.txt ./
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    pip install -i https://pypi.tuna.tsinghua.edu.cn/simple -r requirements-prod.txt

# 2) Application code. Everything the runtime + scripts/build_index.py needs.
COPY src/ ./src/
COPY api/ ./api/
COPY prompts/ ./prompts/
COPY scripts/ ./scripts/

# 3) React bundle from the build stage. api/main.py detects this directory
#    and mounts it at / with SPA fallback.
COPY --from=frontend-build /build/dist /app/frontend/dist

# docs/ and data/ are bind-mounted at runtime (see docker-compose.yml).
# Empty placeholders so src.config can mkdir/stat them even before first mount.
RUN mkdir -p /app/docs /app/data

EXPOSE 8000

# Single worker on purpose: the backend is I/O-bound (HTTP calls to GPU service
# and Qdrant), so a single worker already overlaps I/O and compute.
# `--timeout-keep-alive 300` keeps long SSE streams from disconnecting prematurely
# (default is only 5s, which is a common source of network errors in production).
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--timeout-keep-alive", "300"]
