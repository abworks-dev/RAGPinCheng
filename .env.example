# Zhipu GLM — required for answer generation. Get one at https://bigmodel.cn.
ZHIPU_API_KEY=

# MinerU cloud API — required for PDF parsing during indexing (~1 min/PDF).
# Without this, scripts/build_index.py falls back to the local mineru CLI
# (~5-15 min/PDF, CPU-only). Get one at https://mineru.net.
MINERU_API_KEY=

# Override the default LLM model id used for answer generation. Leave blank to
# use src/config.py's default (currently glm-4.7-flashx). Common values:
# glm-4.7-flashx, glm-4.6, glm-4.5-air.
LLM_MODEL=glm-4.7-flashx

# Optional: model used only for the standalone-query rewrite step. The rewrite
# is short and latency-sensitive, so this defaults to a cheap/fast model
# (glm-4.5-air) instead of LLM_MODEL.
LLM_REWRITE_MODEL=glm-4.5-air
ADMIN_EMPLOYEE_ID=
ADMIN_PASSWORD=
# HuggingFace endpoint. Leave unset to use the real CDN. Set to
# https://hf-mirror.com if the host can't reach huggingface.co directly
# HF_ENDPOINT=https://hf-mirror.com

# Video upload limit (MB). Defaults to 500 MB in src/config.py.
# MAX_VIDEO_UPLOAD_MB=500

# Docker build target architecture (consumed by docker-compose.yml's
# build.platforms). Defaults to linux/amd64 — leave unset on the production
# x86_64 server. On arm64 systems, set linux/arm64 so local builds run
# native instead of through QEMU emulation (~5-10x faster for the rerank
# workload).
# BUILD_PLATFORM=linux/arm64

# GPU inference service (remote provider) — only used when EMBED_PROVIDER
# or RERANK_PROVIDER is set to "remote".  The GPU service runs on a separate
# Windows host with an NVIDIA GPU.
# GPU_SERVICE_URL=http://127.0.0.1:8100
# GPU_SERVICE_TOKEN=
# EMBED_PROVIDER=local        # "local" (in-process BGE) or "remote" (GPU service)
# RERANK_PROVIDER=local       # "local" (in-process reranker) or "remote" (GPU service)

# LibreOffice conversion service — formula recalculation, Office → PDF.
# Runs as a separate container in docker-compose.
# LIBREOFFICE_URL=http://libreoffice:8101
# Ubuntu backend ASR client settings. Windows service settings live in asr_service/.env.example.
ASR_ENABLED=false
ASR_SERVICE_URL=http://127.0.0.1:8200
ASR_SERVICE_TOKEN=
ASR_CONNECT_TIMEOUT_SECONDS=10
ASR_REQUEST_TIMEOUT_SECONDS=60
ASR_POLL_INTERVAL_MS=1000
ASR_UPLOAD_PART_BYTES=8388608
ASR_EXPECTED_API_VERSION=asr-service/1
ASR_JOB_TIMEOUT_SECONDS=7200
ASR_FFMPEG_PATH=ffmpeg
ASR_MEDIA_PREP_TIMEOUT_SECONDS=1800
# Application admission is separate from GPU qualification/runtime identity.
TRANSCRIPTION_ADMITTED_PROFILE_IDS=funasr-sensevoice-zh-experimental-v1
TRANSCRIPTION_ARTIFACT_DIR=./data/transcription-artifacts

# Managed content library. Keep disabled until the R2 code is deployed and
# the separate R3 production migration/cutover has been approved.
CONTENT_MANAGEMENT_ENABLED=false
CONTENT_HEAD_ENFORCEMENT=compat
# Local development only; Compose pins the container path to /app/content.
# CONTENT_ROOT=./content
# Optional Compose host bind source; production injects the approved fixed path.
# CONTENT_HOST_PATH=./content
# Optional legacy source bind. It must not point at the repository project docs.
# DOCS_HOST_PATH=./content/legacy-docs
